---
// Tree crowns seen from above, with segmentation-style outlines. Deterministic, generated at build time.
interface Props { label?: string }
const { label = "Illustration of tree crowns seen from above, outlined like segmentation masks" } = Astro.props;
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const W = 640, H = 420;
const crowns: { cx: number; cy: number; r: number; pts: string; kind: number }[] = [];
for (let i = 0; i < 70; i++) {
  const r = 16 + rnd() * 22, cx = rnd() * W, cy = rnd() * H;
  if (crowns.some((c) => Math.hypot(c.cx - cx, c.cy - cy) < (c.r + r) * 0.78)) continue;
  const n = 14, pts: string[] = [];
  for (let k = 0; k < n; k++) {
    const a = (k / n) * Math.PI * 2, rr = r * (0.82 + rnd() * 0.3);
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  crowns.push({ cx, cy, r, pts: pts.join(" "), kind: rnd() < 0.12 ? 2 : rnd() < 0.45 ? 1 : 0 });
}
const fills = ["#2f6b4a", "#4f8a3e", "#b9773a"];
const strokes = ["#9fe0b8", "#d7f08a", "#ffb36b"];
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%;display:block;background:#1d3a2b">
  <rect width={W} height={H} fill="#21402f" />
  {crowns.map((c) => (
    <g>
      <circle cx={c.cx} cy={c.cy} r={c.r} fill={fills[c.kind]} opacity=".92" />
      <circle cx={c.cx - c.r * 0.25} cy={c.cy - c.r * 0.25} r={c.r * 0.45} fill="#ffffff" opacity=".07" />
      <polygon points={c.pts} fill="none" stroke={strokes[c.kind]} stroke-width="1.6" stroke-dasharray={c.kind === 2 ? "4 3" : undefined} />
    </g>
  ))}
</svg>
