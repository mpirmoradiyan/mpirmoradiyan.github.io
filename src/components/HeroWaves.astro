---
// "From waves to vision": one synthetic seismic wavefield, drawn as wiggle traces on the left
// and as pixels on the right. Generated at build time, deterministic.
const W = 1200, H = 440;
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const reflectors = [
  { y: 70, dip: 0.035, fold: 18, per: 260, a: 1.0 },
  { y: 150, dip: 0.05, fold: 26, per: 300, a: -0.8 },
  { y: 235, dip: 0.02, fold: 34, per: 340, a: 0.9 },
  { y: 315, dip: 0.06, fold: 22, per: 280, a: -0.7 },
  { y: 390, dip: 0.03, fold: 30, per: 360, a: 0.6 },
];
const ricker = (t: number, f = 0.045) => { const p = (Math.PI * f * t) ** 2; return (1 - 2 * p) * Math.exp(-p); };
const field = (x: number, y: number) => {
  let v = 0;
  for (const r of reflectors) v += r.a * ricker(y - (r.y + r.dip * x + r.fold * Math.sin(x / r.per)));
  return v;
};
const split = 560; // x where waves become pixels
const traces: { line: string; fill: string }[] = [];
const dx = 15, gain = 11;
for (let x0 = 12; x0 < split + 40; x0 += dx) {
  let line = "", fill = "";
  const pts: [number, number][] = [];
  for (let y = 0; y <= H; y += 3) pts.push([x0 + gain * (field(x0, y) + 0.06 * (rnd() - 0.5)), y]);
  line = "M" + pts.map(([x, y]) => `${x.toFixed(1)},${y}`).join("L");
  // variable-area fill of positive lobes
  fill = "M" + pts.map(([x, y]) => `${Math.max(x, x0).toFixed(1)},${y}`).join("L") + `L${x0},${H}L${x0},0Z`;
  const fade = x0 > split - 60 ? Math.max(0, 1 - (x0 - (split - 60)) / 100) : 1;
  traces.push({ line, fill: fade > 0 ? fill : "", fade } as any);
}
const cells: { x: number; y: number; o: number; c: string }[] = [];
const cs = 16;
for (let x = split - 40; x < W; x += cs) {
  for (let y = 0; y < H; y += cs) {
    const v = field(x + cs / 2, y + cs / 2);
    const ramp = Math.min(1, Math.max(0, (x - (split - 40)) / 140));
    const o = Math.min(0.95, Math.abs(v)) * ramp;
    if (o < 0.04) continue;
    cells.push({ x, y, o: +o.toFixed(2), c: v > 0 ? "var(--forest)" : "var(--signal)" });
  }
}
---
<svg class="hero-waves" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img"
  aria-label="Seismic wiggle traces on the left turn into a grid of pixels on the right: the same wavefield seen by a geophysicist and by a computer-vision model.">
  <defs>
    <linearGradient id="fadeR" x1="0" x2="1"><stop offset="0" stop-color="var(--bg)" stop-opacity="0"/><stop offset="1" stop-color="var(--bg)" stop-opacity=".0"/></linearGradient>
  </defs>
  <g class="traces">
    {traces.map((t: any, i) => (
      <g style={`opacity:${t.fade}; --d:${i * 35}ms`}>
        {t.fill && <path d={t.fill} fill="var(--ink)" opacity=".75" />}
        <path d={t.line} fill="none" stroke="var(--ink)" stroke-width="1" opacity=".9" />
      </g>
    ))}
  </g>
  <g class="pixels">
    {cells.map((c) => <rect x={c.x + 1} y={c.y + 1} width={cs - 2} height={cs - 2} rx="2.5" fill={c.c} opacity={c.o} />)}
  </g>
</svg>

<style>
  .hero-waves { width: 100%; height: 100%; display: block; }
  .traces g { animation: draw 1.4s ease both; animation-delay: var(--d); }
  .pixels { animation: pix 1.6s .9s ease both; }
  @keyframes draw { from { opacity: 0; transform: translateY(-8px); } }
  @keyframes pix { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .traces g, .pixels { animation: none; } }
</style>
