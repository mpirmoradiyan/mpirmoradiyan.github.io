---
import Base from "../../layouts/Base.astro";
import { journey } from "../../data/journey";
import { details } from "../../data/journeyDetails";
import AcquisitionStory from "../../components/AcquisitionStory.astro";

export function getStaticPaths() {
  return journey.filter((s) => s.slug && details[s.slug]).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const stop = journey.find((s) => s.slug === slug)!;
const d = details[slug!];
const withPages = journey.filter((s) => s.slug && details[s.slug]);
const i = withPages.findIndex((s) => s.slug === slug);
const prev = withPages[i - 1];
const next = withPages[i + 1];
const kindLabel = { school: "School", study: "University", work: "Work" } as const;
---
<Base title={stop.title} description={d.intro} image={stop.image}>
  <section class="container hero">
    <div class="hero-text">
      <a class="back" href="/journey/">← Journey</a>
      <p class="eyebrow">{stop.years} · {kindLabel[stop.kind]}</p>
      <h1>{stop.title}</h1>
      <p class="org">{stop.url ? <a href={stop.url} target="_blank" rel="noopener">{stop.org} ↗</a> : stop.org}<span class="muted"> · {stop.place}</span></p>
      <p class="lead">{d.intro}</p>
    </div>
    <figure class="hero-media card">
      <img src={stop.image} alt={stop.imageAlt} width="800" height="520" />
    </figure>
  </section>

  <div class="container facts" role="list">
    {d.facts.map((f) => (
      <div class="fact card reveal" role="listitem">
        <span class="fact-label">{f.label}</span>
        <span class="fact-value">{f.value}</span>
      </div>
    ))}
  </div>

  <div class="narrow body">
    {d.explainer && (
      <aside class="explainer reveal">
        <p class="eyebrow">Explained simply</p>
        <h2>{d.explainer.title}</h2>
        {d.explainer.paragraphs.map((p) => <p>{p}</p>)}
      </aside>
    )}
  </div>

  {d.story === "acquisition" && <div class="container"><AcquisitionStory /></div>}

  <div class="narrow body">

    {d.blocks.map((b) => (
      <section class="block reveal">
        <h2>{b.heading}</h2>
        {b.paragraphs?.map((p) => <p>{p}</p>)}
        {b.bullets && <ul class="ticks">{b.bullets.map((x) => <li>{x}</li>)}</ul>}
      </section>
    ))}

    {d.links && (
      <section class="block reveal">
        <h2>{d.links.title}</h2>
        <ul class="link-list">
          {d.links.items.map((l) => (
            <li class="card">
              {l.href ? (
                <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener" : undefined}>
                  {l.href.endsWith(".pdf") && <span class="badge">PDF</span>}{l.label}
                </a>
              ) : (
                <span class="link-title">{l.label}</span>
              )}
              {l.note && <span class="muted note">{l.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  {d.courses && (
    <section class="container courses">
      <div class="narrow-head">
        <h2>{d.courses.title}</h2>
        {d.courses.intro && <p class="muted">{d.courses.intro}</p>}
      </div>
      <div class="course-grid">
        {d.courses.groups.map((g) => (
          <div class="course-group card reveal">
            <h3>{g.title}</h3>
            <ul>{g.items.map((c) => <li>{c}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {d.photos && (
    <section class="container">
      <h2 class="photos-title">From the field</h2>
      <div class="gallery">
        {d.photos.map((p) => (
          <figure class="reveal"><img src={p.src} alt={p.alt} loading="lazy" /><figcaption>{p.alt}</figcaption></figure>
        ))}
      </div>
    </section>
  )}

  <nav class="container road-nav" aria-label="Journey stops">
    {prev ? (
      <a class="card step prev" href={`/journey/${prev.slug}/`}>
        <span class="dir">← Previous stop</span>
        <span class="step-years">{prev.years}</span>
        <span class="step-title">{prev.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="card step next" href={`/journey/${next.slug}/`}>
        <span class="dir">Next stop →</span>
        <span class="step-years">{next.years}</span>
        <span class="step-title">{next.title}</span>
      </a>
    ) : (
      <a class="card step next" href="/journey/">
        <span class="dir">Back to the road →</span>
        <span class="step-title">See the whole journey</span>
      </a>
    )}
  </nav>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; padding-bottom: 2rem; }
  .back { display: inline-block; margin-bottom: 1.2rem; font-size: .92rem; text-decoration: none; color: var(--muted); }
  .back:hover { color: var(--signal); }
  .hero h1 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); }
  .org { font-weight: 500; margin-bottom: 1rem; }
  .org a { text-decoration: none; }
  .hero-media { margin: 0; overflow: hidden; aspect-ratio: 4 / 3; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; }

  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-bottom: 1rem; }
  .fact { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: .3rem; }
  .fact-label { font-family: var(--mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--signal); }
  .fact-value { font-weight: 500; line-height: 1.4; }

  .body { padding-top: 1.5rem; }
  .explainer { background: var(--signal-soft); border-left: 4px solid var(--signal); border-radius: 0 var(--radius) var(--radius) 0; padding: 1.4rem 1.6rem .6rem; margin: 1rem 0 1rem; }
  .explainer h2 { margin-top: 0; font-size: 1.45rem; }
  .explainer p { color: var(--ink-soft); }
  .block { padding: 0; }
  .block h2 { font-size: 1.5rem; margin: 2em 0 .6em; }
  .block p { color: var(--ink-soft); }
  .ticks { padding-left: 1.1em; color: var(--ink-soft); }
  .ticks li { margin: .5em 0; }
  .ticks li::marker { color: var(--signal); }

  .link-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .link-list li { padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: .3rem; }
  .link-list a, .link-title { font-weight: 600; text-decoration: none; line-height: 1.4; }
  .link-list a:hover { text-decoration: underline; }
  .note { font-size: .9rem; }
  .badge { display: inline-block; font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; padding: .15em .5em; margin-right: .6em;
    border-radius: 5px; background: var(--forest); color: var(--bg); vertical-align: 2px; }

  .courses { padding-top: 2rem; }
  .narrow-head h2 { margin-top: 0; }
  .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .course-group { padding: 1.1rem 1.25rem; }
  .course-group h3 { margin: 0 0 .7rem; font-size: 1.05rem; color: var(--forest); }
  .course-group ul { list-style: none; padding: 0; margin: 0; }
  .course-group li { padding: .35em 0; border-top: 1px solid var(--line); font-size: .94rem; color: var(--ink-soft); }
  .course-group li:first-child { border-top: 0; }

  .photos-title { margin-top: 0; }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); }
  .gallery figcaption { font-size: .85rem; color: var(--muted); margin-top: .4rem; }

  .road-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 2rem 0 1rem; }
  .step { padding: 1.1rem 1.3rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: .25rem; transition: border-color .2s, transform .2s; }
  .step:hover { border-color: var(--signal); transform: translateY(-2px); color: var(--ink); }
  .step.next { text-align: right; }
  .dir { font-family: var(--mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--signal); }
  .step-years { font-size: .85rem; color: var(--muted); }
  .step-title { font-family: var(--serif); font-weight: 600; font-size: 1.1rem; line-height: 1.3; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-media { order: -1; aspect-ratio: 16 / 9; }
    .facts { grid-template-columns: 1fr 1fr; }
    .gallery { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .facts, .road-nav { grid-template-columns: 1fr; }
    .step.next { text-align: left; }
  }
</style>
