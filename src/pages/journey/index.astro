---
import Base from "../../layouts/Base.astro";
import { journey } from "../../data/journey";
const kindLabel = { school: "School", study: "University", work: "Work" } as const;
---
<Base title="Journey" description="The road from a high school in Isfahan to leading computer-vision work in Sweden.">
  <section class="container intro">
    <p class="eyebrow">The road so far</p>
    <h1>Journey</h1>
    <p class="lead">From mathematics in Isfahan, through fourteen years of seismic field work, to computer vision in Sweden. Every stop added something the next one needed.</p>
  </section>

  <div class="container road" role="list">
    <div class="start reveal"><span>Start</span></div>
    {journey.map((s, i) => {
      const side = i % 2 === 0 ? "left" : "right";
      return (
        <div class={`stop ${side}`} role="listitem">
          <svg class="seg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="asphalt" d={side === "left" ? "M50,0 C50,30 72,35 72,50 C72,65 50,70 50,100" : "M50,0 C50,30 28,35 28,50 C28,65 50,70 50,100"} />
            <path class="lane" d={side === "left" ? "M50,0 C50,30 72,35 72,50 C72,65 50,70 50,100" : "M50,0 C50,30 28,35 28,50 C28,65 50,70 50,100"} />
          </svg>
          <div class="pin reveal"><span>{s.years.split(" ")[0]}</span></div>
          <article class={`stop-card card reveal${s.slug ? " has-page" : ""}`}>
            <div class="media">
              <img src={s.image} alt={s.imageAlt} loading="lazy" width="800" height="520" />
              <span class={`kind ${s.kind}`}>{kindLabel[s.kind]}</span>
            </div>
            <div class="body">
              <p class="years">{s.years}</p>
              <h2>{s.slug ? <a class="stretch" href={`/journey/${s.slug}/`}>{s.title}</a> : s.title}</h2>
              <p class="org">{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.org} ↗</a> : s.org}<span class="muted"> · {s.place}</span></p>
              <p class="story">{s.story}</p>
              {s.slug && <p class="more" aria-hidden="true">Read the story <span>→</span></p>}
            </div>
          </article>
        </div>
      );
    })}
    <div class="end reveal"><span>Next</span></div>
  </div>

  <section class="container" id="credits">
    <h2 style="font-size:1.2rem">Photo credits</h2>
    <ul class="credits muted">
      {journey.filter((s) => s.credit).map((s) => <li>{s.org}, {s.place}: {s.credit}</li>)}
      <li>Field photos (NISOC years): my own. University of Tehran stop (an impedance section like the ones in my MSc thesis) and Arboair stop: generated illustrations.</li>
    </ul>
  </section>
</Base>

<style>
  .intro { padding-bottom: 1rem; }
  .road { position: relative; padding: 1rem 0 2rem; }
  .stop { position: relative; display: grid; grid-template-columns: 1fr 140px 1fr; align-items: center; min-height: 380px; }
  .seg { position: absolute; left: 50%; top: 0; width: 140px; height: 100%; transform: translateX(-50%); overflow: visible; }
  .asphalt { fill: none; stroke: var(--ink); opacity: .88; stroke-width: 34; vector-effect: non-scaling-stroke; stroke-linecap: butt; }
  .lane { fill: none; stroke: #f3d9b8; stroke-width: 2.5; stroke-dasharray: 12 12; opacity: .9; vector-effect: non-scaling-stroke; }
  :global(:root[data-theme="dark"]) .asphalt { stroke: #3b4a43; opacity: 1; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .asphalt { stroke: #3b4a43; opacity: 1; } }
  .pin { grid-column: 2; justify-self: center; z-index: 2; width: 64px; height: 64px; border-radius: 50%; background: var(--signal); color: #fff;
    display: grid; place-items: center; font-family: var(--mono); font-weight: 600; font-size: .9rem; box-shadow: 0 0 0 6px var(--bg), var(--shadow); }
  .stop.left .stop-card { grid-column: 1; grid-row: 1; }
  .stop.right .stop-card { grid-column: 3; grid-row: 1; }
  .stop.left .pin, .stop.right .pin { grid-row: 1; }
  .stop.left .pin { transform: translateX(31px); }
  .stop.right .pin { transform: translateX(-31px); }
  .stop-card { overflow: hidden; margin: 1.2rem 0; }
  .media { position: relative; aspect-ratio: 16 / 9; background: var(--bg-soft); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media :global(svg) { position: absolute; inset: 0; }
  .kind { position: absolute; top: .7rem; left: .7rem; font-size: .72rem; font-family: var(--mono); text-transform: uppercase; letter-spacing: .08em;
    padding: .25em .6em; border-radius: 6px; background: rgba(16, 21, 19, .72); color: #fff; }
  .kind.work { background: rgba(201, 111, 30, .9); }
  .body { padding: 1.1rem 1.25rem 1.3rem; }
  .years { font-family: var(--mono); font-size: .8rem; color: var(--signal); margin: 0 0 .3rem; }
  .body h2 { font-size: 1.3rem; margin: 0 0 .35rem; }
  .org { font-weight: 500; margin-bottom: .6rem; font-size: .95rem; }
  .org a { text-decoration: none; }
  .story { color: var(--ink-soft); margin: 0; font-size: .97rem; }
  .stop-card { position: relative; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .stop-card.has-page:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--signal) 45%, var(--line)); }
  .stop-card.has-page:hover .media img { transform: scale(1.03); }
  .media { overflow: hidden; }
  .media img { transition: transform .5s ease; }
  .stretch { color: inherit; text-decoration: none; }
  .stretch::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--radius); }
  .stretch:focus-visible { outline: none; }
  .stop-card:has(.stretch:focus-visible) { outline: 2px solid var(--signal); outline-offset: 3px; }
  .org a { position: relative; z-index: 2; }
  .more { margin: .8rem 0 0; font-weight: 600; font-size: .9rem; color: var(--forest); }
  .more span { display: inline-block; transition: transform .2s ease; }
  .stop-card.has-page:hover .more span { transform: translateX(4px); }
  .start, .end { display: flex; justify-content: center; }
  .start span, .end span { font-family: var(--mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .14em; padding: .4em .9em; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--muted); position: relative; z-index: 2; }
  .end span { background: var(--forest); color: var(--bg); border-color: var(--forest); }
  .credits { font-size: .85rem; padding-left: 1.1em; }
  @media (max-width: 820px) {
    .stop { grid-template-columns: 64px 1fr; min-height: 0; }
    .seg { left: 32px; width: 64px; }
    .stop .pin { grid-column: 1 !important; transform: none !important; width: 52px; height: 52px; font-size: .78rem; align-self: start; margin-top: 2.2rem; }
    .stop.left .stop-card, .stop.right .stop-card { grid-column: 2; margin-left: .8rem; }
    .start, .end { justify-content: flex-start; padding-left: 4px; }
  }
</style>
