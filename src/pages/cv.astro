---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
const arboair = [
  "Designed and lead the company's computer-vision platform: one config-driven system covering data ingestion, training-data preparation, model training, geospatial evaluation and GPU inference in production.",
  "Train modern deep-learning segmentation models for tree species and forest-damage mapping, from transformer-based architectures with foundation-model backbones to classic CNNs, across semantic, instance and panoptic tasks.",
  "Built self-supervised pretraining on unlabelled aerial imagery and semi-supervised pseudo-labelling to make the most of scarce annotations.",
  "Built the training-data foundation: a versioned data lake with provenance, intake of finished annotation jobs, reproducible dataset recipes and leakage-safe splits.",
  "Turn pixel predictions into GIS-ready maps: tiled inference over very large GeoTIFFs, vectorisation, geometry repair and certainty scoring.",
  "Contributed to the orthomosaic pipeline: LiDAR terrain models, direct georeferencing from drone metadata, seamline mosaicking and photogrammetric true orthophotos.",
  "Led the tree stem-diameter estimation project end to end, from field reference data and aerial height data to a production model with staged releases.",
  "As AI lead, set up an AI-agent-assisted engineering workflow and designed an AI-agent research process supporting the company's strategy work.",
];
const skills = [
  ["Computer vision", "Semantic, instance and panoptic segmentation; object detection; vision transformers and foundation-model backbones; self- and semi-supervised learning; OpenCV"],
  ["Deep learning", "PyTorch, Hugging Face Transformers, Detectron2, segmentation-models-pytorch, timm; TensorFlow/Keras"],
  ["Geospatial", "Rasterio, GDAL, GeoPandas, Shapely, PDAL; LiDAR; GeoTIFF/GeoPackage"],
  ["Data & tooling", "Python, NumPy, Polars, DuckDB, Pydantic, pytest, Streamlit, Dash, CVAT"],
  ["Statistics", "Regression, validation design, Bayesian methods, causal inference"],
  ["Basic / working knowledge", "Docker, AWS (S3, SQS, SageMaker), GitHub Actions; photogrammetry, orthorectification and remote sensing (learning); C++ (learning)"],
];
---
<Base title="CV" description={`Curriculum vitae of ${profile.name}, ${profile.role}.`}>
  <div class="narrow cv">
    <header>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="contact">
        <span>{profile.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin}><span class="screen-only">LinkedIn</span><span class="print-only">linkedin.com/in/mohsen-pirmoradiyan</span></a>
        <a href={profile.github}><span class="screen-only">GitHub</span><span class="print-only">github.com/mpirmoradiyan</span></a>
        <a class="print-only" href="https://mpirmoradiyan.github.io">mpirmoradiyan.github.io</a>
      </p>
      <p class="noprint actions">
        <a class="btn primary" href="/docs/Mohsen_Pirmoradiyan_CV.pdf" download>Download PDF</a>
      </p>
    </header>

    <section>
      <h2>Profile</h2>
      <p>Computer-vision and AI engineer who builds production deep-learning systems for drone and aerial imagery: segmentation, self-supervised learning and geospatial ML. Before moving into machine learning I spent fourteen years in seismic field operations, which shaped how I work: start from the signal, check the data before trusting it, and think in geometry.</p>
    </section>

    <section>
      <h2>Experience</h2>
      <div class="entry">
        <div class="when">Feb 2022 – present</div>
        <div><h3>AI Lead &amp; Computer Vision Engineer</h3><p class="where">Arboair AB, Linköping, Sweden · drone and aerial analytics for forestry</p>
          <ul>{arboair.map((a) => <li>{a}</li>)}</ul></div>
      </div>
      <div class="entry">
        <div class="when">2005 – 2019</div>
        <div><h3>Seismic Data Acquisition QC Supervisor (junior to senior)</h3><p class="where">National Iranian South Oil Company (NISOC), Khuzestan, Iran</p>
          <ul>
            <li>Quality control of 2D and 3D land seismic acquisition in deserts, sand dunes and mountains: recording quality, geometry and field procedures.</li>
            <li>Supervised acquisition in more than five oil fields, with dynamite and vibroseis sources; reviewed survey design and field data before processing.</li>
            <li>Mentored junior geophysicists; recognised as one of the company's best seismic acquisition supervisors in 2015.</li>
          </ul></div>
      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div class="entry"><div class="when">2019 – 2021</div><div><h3>MSc Statistics and Machine Learning</h3><p class="where">Linköping University, Sweden</p><p>Thesis with Ericsson Research: <em>Anomaly detection and causal inference in 5G mobile networks</em>.</p></div></div>
      <div class="entry"><div class="when">2009 – 2012</div><div><h3>MSc Geophysics (Seismology)</h3><p class="where">Institute of Geophysics, University of Tehran, Iran</p><p>Thesis: <em>Petroleum reservoir characterization using seismic data analysis</em> (prestack seismic inversion).</p></div></div>
      <div class="entry"><div class="when">2000 – 2004</div><div><h3>BSc Petroleum Exploration Engineering</h3><p class="where">Petroleum University of Technology, Ahvaz, Iran</p></div></div>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">{skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>

    <section>
      <h2>Learning in public</h2>
      <p>I keep short <a href="/notes/">learning notes</a> on what I learn: computer vision, geospatial data, signal processing, statistics and machine learning.<span class="print-only"> mpirmoradiyan.github.io/notes</span></p>
    </section>
  </div>
</Base>

<style>
  .cv { padding: 2.5rem 0; }
  .cv header { border-bottom: 2px solid var(--forest); padding-bottom: 1rem; margin-bottom: 1rem; }
  .cv h1 { margin-bottom: .1em; }
  .role { font-family: var(--serif); font-size: 1.3rem; color: var(--signal); margin: 0 0 .6rem; }
  .contact { display: flex; gap: 1rem; flex-wrap: wrap; font-size: .92rem; color: var(--muted); margin: 0; }
  .cv h2 { font-size: 1.25rem; text-transform: uppercase; letter-spacing: .08em; font-family: var(--sans); color: var(--forest); margin: 2rem 0 .8rem; }
  .entry { display: grid; grid-template-columns: 150px 1fr; gap: 1rem; margin-bottom: 1.2rem; }
  .when { font-family: var(--mono); font-size: .82rem; color: var(--muted); padding-top: .25rem; }
  .entry h3 { margin: 0; font-size: 1.1rem; }
  .where { color: var(--ink-soft); margin: .1rem 0 .5rem; font-size: .93rem; }
  .entry ul { padding-left: 1.1em; margin: 0; }
  .entry li { margin: .3em 0; font-size: .95rem; }
  .skills { display: grid; grid-template-columns: 190px 1fr; gap: .5rem 1rem; margin: 0; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; color: var(--ink-soft); }
  .noprint { margin-top: 1rem; }
  @media (max-width: 620px) { .entry, .skills { grid-template-columns: 1fr; gap: .2rem; } }
  .print-only { display: none; }
  .actions { display: flex; gap: .6rem; flex-wrap: wrap; }
  @page { size: A4; margin: 13mm 14mm 13mm 14mm; }
  @media print {
    :global(:root:root:root) {
      --bg: #fff; --bg-soft: #fff; --surface: #fff; --ink: #111; --ink-soft: #222; --muted: #555; --line: #ccc;
      --forest: #1f4d3a; --signal: #a85a14; color-scheme: light;
    }
    :global(.site-header), :global(.site-footer), .noprint, .screen-only { display: none !important; }
    .print-only { display: inline; }
    :global(html), :global(body) { background: #fff !important; color: #111; font-size: 9.6pt; line-height: 1.38; }
    :global(main) { padding: 0 !important; margin: 0 !important; }
    .cv { width: 100%; max-width: none; padding: 0; margin: 0; }
    .cv section { padding: 0 !important; margin: 0; }
    .cv header { padding-bottom: .45rem; margin-bottom: .2rem; border-bottom-width: 1.5px; }
    .cv h1 { font-size: 22pt; margin: 0; }
    .role { font-size: 12.5pt; margin: .05rem 0 .3rem; }
    .contact { gap: .25rem 1rem; font-size: 8.8pt; color: #333; }
    .contact a { color: #111; text-decoration: none; }
    .cv h2 { font-size: 10.5pt; margin: .85rem 0 .35rem; padding-bottom: .1rem; border-bottom: 1px solid #ddd; break-after: avoid; }
    .entry { grid-template-columns: 96px 1fr; gap: .55rem; margin-bottom: .55rem; break-inside: avoid; }
    .when { font-size: 8.2pt; padding-top: .1rem; color: #444; }
    .entry h3 { font-size: 10.5pt; }
    .where { font-size: 8.9pt; margin: 0 0 .2rem; color: #444; }
    .entry li { font-size: 9.2pt; margin: .12em 0; }
    .entry p { margin: 0 0 .2rem; }
    .skills { grid-template-columns: 128px 1fr; gap: .15rem .7rem; font-size: 9.1pt; }
    a { color: inherit; text-decoration: none; }
    p { orphans: 3; widows: 3; }
  }
</style>
