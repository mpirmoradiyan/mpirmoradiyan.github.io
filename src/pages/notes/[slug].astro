---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { topics, readingMinutes } from "../../data/topics";

export async function getStaticPaths() {
  const all = (await getCollection("notes")).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return all.map((note) => {
    const same = all.filter((n) => n.data.topic === note.data.topic);
    const i = same.findIndex((n) => n.id === note.id);
    return { params: { slug: note.id }, props: { note, prev: same[i - 1], next: same[i + 1] } };
  });
}
const { note, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
const t = topics.find((x) => x.key === note.data.topic);
const when = note.data.date.toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={note.data.title} description={note.data.summary}>
  <article class="container layout">
    <header class="note-head">
      <a class="back" href={`/notes/#${t?.slug ?? ""}`}>← {note.data.topic}</a>
      <h1>{note.data.title}</h1>
      <p class="lead">{note.data.summary}</p>
      <p class="meta">
        <span>First explored {when}</span><span>·</span><span>{readingMinutes(note.body)} min read</span>
      </p>
      <div class="tags">{note.data.tags.map((g) => <span class="chip">{g}</span>)}</div>
    </header>
    <aside class="toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </aside>
    <div class="prose"><Content /></div>
    <nav class="pn" aria-label="More in this topic">
      {prev ? <a class="card" href={`/notes/${prev.id}/`}><span class="muted">← Earlier in {note.data.topic}</span>{prev.data.title}</a> : <span />}
      {next ? <a class="card right" href={`/notes/${next.id}/`}><span class="muted">Later in {note.data.topic} →</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; column-gap: 3rem; padding-top: 2.5rem; }
  .note-head { grid-column: 1 / -1; max-width: 820px; margin-bottom: 1.5rem; }
  .note-head h1 { font-size: clamp(1.9rem, 4.2vw, 2.8rem); }
  .back { font-size: .9rem; text-decoration: none; display: inline-block; margin-bottom: 1rem; }
  .meta { display: flex; gap: .5rem; flex-wrap: wrap; font-family: var(--mono); font-size: .8rem; color: var(--muted); margin: 0 0 .8rem; }
  .tags { display: flex; gap: .35rem; flex-wrap: wrap; }
  .prose { grid-column: 1; grid-row: 2; min-width: 0; }
  .toc { grid-column: 2; grid-row: 2; position: sticky; top: 88px; align-self: start; font-size: .88rem; }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line); }
  .toc li a { display: block; padding: .3em .9em; color: var(--muted); text-decoration: none; }
  .toc li a:hover { color: var(--forest); }
  .pn { grid-column: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  .pn a { padding: 1rem 1.1rem; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: .3rem; font-weight: 500; }
  .pn a span { font-size: .8rem; font-weight: 400; }
  .pn .right { text-align: right; }
  @media (max-width: 980px) { .layout { grid-template-columns: 1fr; } .toc { display: none; } .pn { grid-template-columns: 1fr; } .pn .right { text-align: left; } }
</style>
