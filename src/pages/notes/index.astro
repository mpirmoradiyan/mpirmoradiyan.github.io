---
import Base from "../../layouts/Base.astro";
import NoteCard from "../../components/NoteCard.astro";
import { getCollection } from "astro:content";
import { topics, readingMinutes } from "../../data/topics";
const all = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byTopic = topics.map((t) => ({ ...t, notes: all.filter((n) => n.data.topic === t.key) })).filter((t) => t.notes.length);
const years = [...new Set(all.map((n) => n.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const index = all.map((n) => ({ id: n.id, t: n.data.title, s: n.data.summary, g: n.data.tags.join(" "), p: n.data.topic }));
---
<Base title="Lab Notes" description="Short, single-topic notes on computer vision, geospatial data, signal processing and machine learning, written from my own experiments.">
  <section class="container head">
    <p class="eyebrow">Lab notes</p>
    <h1>Things I learned by building them</h1>
    <p class="lead">Over the years I have tried ideas in notebooks while reading, watching lectures, doing university labs or solving problems at work. These are those experiments, rewritten as short articles: one idea per note, explained plainly, with code that runs and the sources I learned from.</p>
    <p class="muted">{all.length} notes · {byTopic.length} topics · {Math.min(...years)}–{Math.max(...years)} · dates show when I first explored each topic.</p>

    <div class="controls">
      <input id="q" type="search" placeholder="Search notes, e.g. attention, LiDAR, wavelet" aria-label="Search notes" />
      <div class="views" role="tablist" aria-label="View">
        <button class="on" data-view="topics" role="tab" aria-selected="true">By topic</button>
        <button data-view="timeline" role="tab" aria-selected="false">Timeline</button>
      </div>
    </div>
    <div class="chips" id="chips">
      <button class="chip on" data-topic="">All</button>
      {byTopic.map((t) => <button class="chip" data-topic={t.key}>{t.key} <span>{t.notes.length}</span></button>)}
    </div>
  </section>

  <div class="container" id="view-topics">
    {byTopic.map((t) => (
      <section class="topic" data-topic={t.key} id={t.slug}>
        <div class="topic-head"><h2>{t.key}</h2><p class="muted">{t.blurb}</p></div>
        <div class="grid">
          {t.notes.map((n) => <div class="item" data-id={n.id}><NoteCard id={n.id} title={n.data.title} summary={n.data.summary} topic={n.data.topic} date={n.data.date} minutes={readingMinutes(n.body)} lab={n.data.tags.includes("university-lab")} /></div>)}
        </div>
      </section>
    ))}
  </div>

  <div class="container" id="view-timeline" hidden>
    {years.map((y) => (
      <section class="year">
        <h2 class="y">{y}</h2>
        <ol class="tl">
          {all.filter((n) => n.data.date.getUTCFullYear() === y).map((n) => (
            <li class="item" data-id={n.id} data-topic={n.data.topic}>
              <time>{n.data.date.toLocaleDateString("en-GB", { month: "short", timeZone: "UTC" })}</time>
              <a href={`/notes/${n.id}/`}>{n.data.title}</a>
              <span class="chip">{n.data.topic}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <p class="container muted" id="empty" hidden>No notes match that search.</p>

  <script is:inline define:vars={{ index }}>
    const q = document.getElementById("q"), chips = document.getElementById("chips");
    let topic = "";
    const norm = (s) => s.toLowerCase();
    function apply() {
      const words = norm(q.value).split(/\s+/).filter(Boolean);
      const ok = new Set(index.filter((n) => (!topic || n.p === topic) && words.every((w) => norm(n.t + " " + n.s + " " + n.g + " " + n.p).includes(w))).map((n) => n.id));
      document.querySelectorAll(".item").forEach((el) => (el.hidden = !ok.has(el.dataset.id)));
      document.querySelectorAll(".topic, .year").forEach((sec) => (sec.hidden = ![...sec.querySelectorAll(".item")].some((i) => !i.hidden)));
      document.getElementById("empty").hidden = ok.size > 0;
    }
    q.addEventListener("input", apply);
    chips.addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      chips.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
      topic = b.dataset.topic; apply();
    });
    document.querySelectorAll(".views button").forEach((b) => b.addEventListener("click", () => {
      document.querySelectorAll(".views button").forEach((x) => { x.classList.toggle("on", x === b); x.setAttribute("aria-selected", String(x === b)); });
      document.getElementById("view-topics").hidden = b.dataset.view !== "topics";
      document.getElementById("view-timeline").hidden = b.dataset.view !== "timeline";
    }));
  </script>
</Base>

<style>
  .head { padding-bottom: 1.5rem; }
  .controls { display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; margin-top: 1.5rem; }
  #q { flex: 1 1 280px; padding: .75em 1.1em; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; }
  .views { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--surface); }
  .views button { border: 0; background: transparent; padding: .45em 1em; border-radius: 999px; cursor: pointer; color: var(--ink-soft); font: inherit; font-size: .9rem; }
  .views button.on { background: var(--forest); color: var(--bg); }
  .chips { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: 1rem; }
  .chips .chip { cursor: pointer; font: inherit; font-size: .82rem; }
  .chips .chip span { opacity: .6; margin-left: .2em; }
  .chips .chip.on { background: var(--forest); color: var(--bg); border-color: var(--forest); }
  .topic { padding: 1.5rem 0 1rem; }
  .topic-head h2 { margin: 0 0 .2rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1rem; }
  .year { padding: 1rem 0; display: grid; grid-template-columns: 110px 1fr; gap: 1rem; border-top: 1px solid var(--line); }
  .y { margin: .3rem 0; font-size: 1.8rem; color: var(--signal); }
  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li { display: grid; grid-template-columns: 52px 1fr auto; gap: .8rem; align-items: baseline; padding: .55rem 0; border-bottom: 1px dashed var(--line); }
  .tl time { font-family: var(--mono); font-size: .8rem; color: var(--muted); }
  .tl a { text-decoration: none; color: var(--ink); font-weight: 500; }
  .tl a:hover { color: var(--forest); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } .year { grid-template-columns: 1fr; } .tl li { grid-template-columns: 46px 1fr; } .tl .chip { display: none; } }
</style>
